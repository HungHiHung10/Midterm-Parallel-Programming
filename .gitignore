# Dataset binaries are distributed through the public Drive link, not Git.
# Keep the directory skeleton, documentation, and reproducibility manifest.
dataset/raw/**
!dataset/raw/.gitkeep
dataset/prepared/**/*.png
dataset/prepared/**/*.jpg
dataset/prepared/**/*.jpeg
dataset/synthetic/*.png
dataset/synthetic/*.jpg
dataset/synthetic/*.jpeg
